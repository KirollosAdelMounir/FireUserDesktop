<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UserIdentityDesktop.ViewModels" xmlns:views="using:UserIdentityDesktop.Views" x:Class="UserIdentityDesktop.Views.ChatView"
             x:Name="RootChatView" x:DataType="vm:ChatViewModel" Background="{DynamicResource ForgeBg}"
             Foreground="{DynamicResource ForgeTextPrimary}" Classes.reduced-motion="{Binding Workspace.ReduceMotion}">
  <UserControl.Styles>
    <Style Selector="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" /><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ForgePrimaryGradientSubtle}" /></Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ForgeSurfaceHover}" /></Style>
    <Style Selector="ListBox.message-stream"><Setter Property="Padding" Value="28,20" /></Style>
    <Style Selector="ListBox.message-stream ListBoxItem:selected /template/ ContentPresenter, ListBox.message-stream ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Grid.msg-row.mine"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
    <Style Selector="Grid.msg-row.theirs"><Setter Property="HorizontalAlignment" Value="Left" /></Style>
    <Style Selector="Grid.msg-row.call"><Setter Property="HorizontalAlignment" Value="Center" /></Style>
    <Style Selector="Border.msg-bubble"><Setter Property="Background" Value="{DynamicResource ForgeBubbleReceived}" /><Setter Property="BorderBrush" Value="{DynamicResource ForgeBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4,15,15,15" /><Setter Property="Padding" Value="14,10" /></Style>
    <Style Selector="Border.msg-bubble.mine"><Setter Property="Background" Value="{DynamicResource ForgeBubbleSent}" /><Setter Property="BorderBrush" Value="{DynamicResource ForgeBubbleSentBorder}" /><Setter Property="CornerRadius" Value="15,4,15,15" /></Style>
    <Style Selector="Button.message-more"><Setter Property="Opacity" Value="0.15" /><Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="6" /><Setter Property="Margin" Value="4,3" /></Style>
    <Style Selector="Grid.msg-row:pointerover Button.message-more, Button.message-more:focus"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Border.recipient-row Button.recipient-more"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="Border.recipient-row:pointerover Button.recipient-more, Button.recipient-more:focus"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="TextBox.composer"><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="8,10" /></Style>
    <Style Selector="TabControl.details-tabs TabItem"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="9,8" /><Setter Property="MinHeight" Value="36" /></Style>
  </UserControl.Styles>
  <Panel>
    <Grid x:Name="ChatLayout" ColumnDefinitions="300,*">
      <Border Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto" Margin="22,22,16,14">
            <StackPanel Spacing="4"><TextBlock Text="Chats" FontSize="24" FontWeight="SemiBold" /><TextBlock Classes="caption" Text="{Binding FilteredRecipients.Count, StringFormat='{}{0} conversations'}" /></StackPanel>
            <Button x:Name="FindPeopleButton" Grid.Column="1" Classes="quiet square" VerticalAlignment="Center" ToolTip.Tip="New conversation" AutomationProperties.Name="New conversation">
              <PathIcon Data="{StaticResource Glyph.Plus}" Width="18" Height="18" />
              <Button.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><StackPanel Width="320" Spacing="12">
                <TextBlock Text="Find a colleague" FontSize="17" FontWeight="SemiBold" />
                <TextBox Text="{Binding IdentitySearchText}" PlaceholderText="Search by name or email" AutomationProperties.Name="Find people" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearching}" Height="2" />
                <ScrollViewer MaxHeight="320"><ItemsControl x:Name="PeopleSearchResults" ItemsSource="{Binding SearchResults}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:UserSearchItemViewModel">
                  <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding #RootChatView.((vm:ChatViewModel)DataContext).StartChatFromSearchCommand}" CommandParameter="{Binding}" Click="SearchResult_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12"><Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ForgePrimaryGradientSubtle}"><TextBlock Text="{Binding Initials}" Foreground="{DynamicResource ForgePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding FullName}" VerticalAlignment="Center" /></StackPanel>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
              </StackPanel></Flyout></Button.Flyout>
            </Button>
          </Grid>
          <TextBox Grid.Row="1" Text="{Binding SearchText}" PlaceholderText="Search conversations" Margin="16,0,16,14" AutomationProperties.Name="Search conversations" />
          <ListBox Grid.Row="2" ItemsSource="{Binding FilteredRecipients}" SelectedItem="{Binding SelectedRecipient}" Margin="10,0" Padding="0,0,0,12">
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:RecipientItemViewModel">
              <Border Classes="recipient-row" Padding="12,14" ContextRequested="Recipient_ContextRequested">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Panel Width="42" Height="42"><Border CornerRadius="21" Background="{DynamicResource ForgePrimaryGradientSubtle}"><TextBlock Text="{Binding Initials}" FontSize="14" Foreground="{DynamicResource ForgePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><Border CornerRadius="21" ClipToBounds="True" IsVisible="{Binding Avatar, Converter={StaticResource NullToBoolConverter}}"><Image Source="{Binding Avatar}" Stretch="UniformToFill" /></Border><Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Stroke="{DynamicResource ForgeSurface}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Panel>
                  <StackPanel Grid.Column="1" Margin="12,2,6,0" Spacing="5"><TextBlock Text="{Binding ReceiverName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding LastMessage}" FontSize="12" Foreground="{DynamicResource ForgeTextMuted}" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right"><TextBlock Classes="caption" Text="{Binding LastSent, Converter={StaticResource DateTimeFormatConverter}}" /><Button Classes="quiet recipient-more" Width="24" Height="22" Padding="4" Click="RecipientMenu_Click" AutomationProperties.Name="Conversation actions"><PathIcon Data="{StaticResource Glyph.More}" Width="15" Height="15" /></Button><Ellipse Width="6" Height="6" Fill="{DynamicResource ForgePrimary}" IsVisible="{Binding !IsSeen}" /></StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="3" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,1,0,0" Padding="16,14">
            <Grid ColumnDefinitions="Auto,*,Auto"><Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource ForgePrimaryGradientSubtle}"><TextBlock Text="{Binding CurrentUser.Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ForgePrimary}" /></Border><StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding CurrentUser.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="6" Height="6" Fill="{Binding CurrentStatusColor}" /><TextBlock Classes="caption" Text="{Binding CurrentStatusLabel}" /></StackPanel></StackPanel>
              <Button Grid.Column="2" Classes="quiet square" Click="AccountMenu_Click" AutomationProperties.Name="Account menu"><PathIcon Data="{StaticResource Glyph.More}" Width="18" Height="18" /></Button>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1" x:Name="ConversationSurface" ColumnDefinitions="*,Auto">
        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding SelectedRecipient, Converter={StaticResource NullToBoolConverter}}">
          <Border Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button x:Name="ConversationProfileButton" Grid.ColumnSpan="2" Classes="quiet" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="HeaderProfile_Click" AutomationProperties.Name="View conversation profile"><Grid ColumnDefinitions="Auto,*"><Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource ForgePrimaryGradientSubtle}"><Panel><TextBlock Text="{Binding SelectedRecipientInitials}" Foreground="{DynamicResource ForgePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding SelectedRecipientAvatar}" Stretch="UniformToFill" /></Panel></Border><StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding SelectedRecipientName}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding SelectedRecipientStatusLabel}" Classes="caption" /></StackPanel></Grid></Button>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="quiet square" Command="{Binding Workspace.StartVoiceCommand}" IsEnabled="{Binding Workspace.CanStartCall}" ToolTip.Tip="Voice call" AutomationProperties.Name="Voice call"><PathIcon Data="{StaticResource Glyph.Phone}" Width="18" Height="18" /></Button>
                <Button Classes="quiet square" Command="{Binding Workspace.StartVideoCommand}" IsEnabled="{Binding Workspace.CanStartCall}" ToolTip.Tip="Video call" AutomationProperties.Name="Video call"><PathIcon Data="{StaticResource Glyph.Camera}" Width="19" Height="19" /></Button>
                <Button Classes="quiet square" Click="ConversationMenu_Click" ToolTip.Tip="Conversation details" AutomationProperties.Name="Conversation actions"><PathIcon Data="{StaticResource Glyph.More}" Width="19" Height="19" /></Button>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto">
            <Button Content="Earlier messages" Classes="quiet" Command="{Binding LoadMoreMessagesCommand}" IsVisible="{Binding HasMoreMessages}" HorizontalAlignment="Center" Margin="0,8" />
            <ListBox x:Name="MessageStream" Grid.Row="1" Classes="message-stream" ItemsSource="{Binding Messages}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChatMessageItemViewModel">
                <Grid Classes="msg-row" Classes.mine="{Binding IsMine}" Classes.theirs="{Binding !IsMine}" Classes.call="{Binding IsCall}" ColumnDefinitions="*,Auto" Margin="0,5" MaxWidth="560" ContextRequested="Message_ContextRequested">
                  <Border Classes="msg-bubble" Classes.mine="{Binding IsMine}" IsVisible="{Binding !IsCall}">
                    <StackPanel Spacing="6">
                      <Border BorderBrush="{DynamicResource ForgePrimary}" BorderThickness="2,0,0,0" Padding="9,3" IsVisible="{Binding HasReply}"><TextBlock Text="{Binding ReplyLabel}" FontSize="11" Foreground="{DynamicResource ForgeTextSecondary}" /></Border>
                      <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" LineHeight="21" IsVisible="{Binding HasText}" />
                      <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ChatAttachmentItemViewModel">
                        <StackPanel Spacing="6"><views:InlineAudioPlayer Attachment="{Binding}" IsSent="{Binding $parent[ItemsControl].((vm:ChatMessageItemViewModel)DataContext).IsMine}" IsVisible="{Binding IsAudio}" /><Button Command="{Binding DownloadCommand}" IsVisible="{Binding !IsAudio}" IsEnabled="{Binding !IsDownloading}" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10" Margin="0,3" AutomationProperties.Name="{Binding FileName}">
                          <StackPanel Spacing="8"><Image Source="{Binding Thumbnail}" IsVisible="{Binding Thumbnail, Converter={StaticResource NullToBoolConverter}}" MaxHeight="200" MaxWidth="320" Stretch="Uniform" /><Grid ColumnDefinitions="Auto,*"><Border Background="{DynamicResource ForgePrimaryGradientSubtle}" Width="36" Height="40" CornerRadius="8"><PathIcon Data="{StaticResource Glyph.File}" Width="18" Height="22" Foreground="{DynamicResource ForgePrimary}" /></Border><StackPanel Grid.Column="1" Margin="10,2,0,0" Spacing="4"><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" MaxWidth="310" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding FormattedFileSize}" Classes="caption" /></StackPanel></Grid></StackPanel>
                        </Button></StackPanel>
                      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      <TextBlock Text="{Binding ReactionLabel}" IsVisible="{Binding HasReactions}" FontSize="15" FontFamily="Noto Color Emoji, Segoe UI Emoji, Apple Color Emoji" Margin="0,3" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6"><TextBlock Text="Edited" IsVisible="{Binding Edited}" Classes="caption" /><TextBlock Text="{Binding TimeSent, Converter={StaticResource DateTimeFormatConverter}}" Classes="caption" /><Grid Width="18" Height="14" IsVisible="{Binding IsMine}" ToolTip.Tip="{Binding ReceiptLabel}" AutomationProperties.Name="{Binding ReceiptLabel}"><Path Stroke="{DynamicResource ForgeTextSecondary}" StrokeThickness="1.5" Data="M2,7 L6,11 14,3" IsVisible="{Binding !Seen}" /><Path Stroke="{DynamicResource ForgePrimary}" StrokeThickness="1.5" Data="M1,7 L5,11 13,3 M7,10 L9,12 17,4" IsVisible="{Binding Seen}" /></Grid></StackPanel>
                    </StackPanel>
                  </Border>
                  <Border IsVisible="{Binding IsCall}" Background="{DynamicResource ForgeSurfaceCard}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1" CornerRadius="14" Padding="18,14" MinWidth="260">
                    <Grid ColumnDefinitions="Auto,*"><Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource ForgePrimaryGradientSubtle}"><PathIcon Data="{StaticResource Glyph.Phone}" Width="18" Height="18" Foreground="{DynamicResource ForgePrimary}" /></Border><StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="7"><TextBlock Text="{Binding CallLabel}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding TimeSent, Converter={StaticResource DateTimeFormatConverter}}" Classes="caption" /><Button Content="Join call" Classes="fire-btn" IsVisible="{Binding CanJoinCall}" Click="JoinCall_Click" /></StackPanel></Grid>
                  </Border>
                  <Button Grid.Column="1" Classes="quiet message-more" VerticalAlignment="Top" Click="MessageMenu_Click" AutomationProperties.Name="Message actions"><PathIcon Data="{StaticResource Glyph.More}" Width="16" Height="16" /></Button>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingMessages}" VerticalAlignment="Top" Height="2" Grid.Row="1" />
            <TextBlock Grid.Row="2" Text="{Binding ChatActivityLabel}" Classes="caption" Margin="28,4,0,8" TextWrapping="Wrap" />
          </Grid>
          <StackPanel Grid.Row="2" Margin="24,10,24,18" Spacing="8" views:EnterSubmit.Command="{Binding SendMessageCommand}">
            <Border IsVisible="{Binding HasMessageAction}" BorderBrush="{DynamicResource ForgePrimary}" BorderThickness="2,0,0,0" Background="{DynamicResource ForgeSurface}" CornerRadius="8" Padding="12,9"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding MessageActionLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="quiet square" Command="{Binding CancelMessageActionCommand}" AutomationProperties.Name="Cancel reply or edit"><PathIcon Data="{StaticResource Glyph.Close}" Width="12" Height="12" /></Button></Grid></Border>
            <ItemsControl ItemsSource="{Binding PendingAttachments}" IsVisible="{Binding PendingAttachments.Count}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PendingAttachmentViewModel"><Border Classes="detail-card" Padding="10,6" Margin="0,0,6,4"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding FileName}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Classes="quiet square" Command="{Binding #RootChatView.((vm:ChatViewModel)DataContext).RemovePendingAttachmentCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Remove attachment"><PathIcon Data="{StaticResource Glyph.Close}" Width="10" Height="10" /></Button></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border IsVisible="{Binding CanTypeMessage}" Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1" CornerRadius="14" Padding="7"><Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <Button Classes="quiet square" Command="{Binding AttachFilesCommand}" VerticalAlignment="Bottom" ToolTip.Tip="Attach files" AutomationProperties.Name="Attach files"><PathIcon Data="{StaticResource Glyph.Attach}" Width="17" Height="20" /></Button>
              <TextBox Grid.Column="1" x:Name="MessageInputBox" Classes="composer" Text="{Binding MessageDraft}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" MaxHeight="120" PlaceholderText="Write a message…" AutomationProperties.Name="Message" />
              <Button Grid.Column="2" Classes="quiet square" Command="{Binding ToggleVoiceRecordingCommand}" Foreground="{DynamicResource ForgePrimary}" ToolTip.Tip="{Binding VoiceRecordingLabel}" AutomationProperties.Name="{Binding VoiceRecordingLabel}"><PathIcon Width="16" Height="20" Data="M9,2 C9,0 15,0 15,2 L15,11 C15,15 9,15 9,11 Z M5,10 L7,10 7,11 C7,18 17,18 17,11 L17,10 19,10 19,11 C19,15 16,18 13,18 L13,21 17,21 17,23 7,23 7,21 11,21 11,18 C8,18 5,15 5,11 Z" /></Button>
              <Button Grid.Column="3" Classes="fire-btn square" Command="{Binding SendMessageCommand}" IsEnabled="{Binding !IsSendingMessage}" VerticalAlignment="Bottom" ToolTip.Tip="Send · Enter" AutomationProperties.Name="Send message"><PathIcon Data="{StaticResource Glyph.Send}" Width="18" Height="18" /></Button>
            </Grid></Border>
            <Border x:Name="VoiceComposer" IsVisible="{Binding VoiceComposerActive}" Background="{DynamicResource ForgeBgSecondary}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1.5" CornerRadius="32" Padding="16,6,8,6">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Button Classes="quiet square" Command="{Binding DiscardVoiceNoteCommand}" IsEnabled="{Binding !IsSendingMessage}" Foreground="{DynamicResource ForgePrimary}" CornerRadius="22" ToolTip.Tip="Discard voice note" AutomationProperties.Name="Discard voice note"><PathIcon Width="22" Height="22" Data="F0 M6,7 L18,7 17,21 7,21 Z M4,4 L9,4 10,2 14,2 15,4 20,4 20,6 4,6 Z M9,9 L11,9 11,19 9,19 Z M13,9 L15,9 15,19 13,19 Z" /></Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding !HasVoiceNote}">
                  <PathIcon Width="22" Height="22" Foreground="{DynamicResource ForgePrimary}" Data="M9,2 C9,0 15,0 15,2 L15,11 C15,15 9,15 9,11 Z M5,10 L7,10 7,11 C7,18 17,18 17,11 L17,10 19,10 19,11 C19,15 16,18 13,18 L13,21 17,21 17,23 7,23 7,21 11,21 11,18 C8,18 5,15 5,11 Z" />
                  <TextBlock Text="{Binding VoiceStatusLabel}" Foreground="{DynamicResource ForgeTextPrimary}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <views:InlineAudioPlayer Grid.Column="1" LocalPath="{Binding VoiceNotePath}" MaxWidth="Infinity" IsVisible="{Binding HasVoiceNote}" AutomationProperties.Name="Preview voice note" />
                <Button Grid.Column="2" Classes="quiet square" Command="{Binding ToggleVoiceRecordingCommand}" IsVisible="{Binding IsRecordingVoice}" Foreground="{DynamicResource ForgePrimary}" CornerRadius="22" ToolTip.Tip="Stop recording" AutomationProperties.Name="Stop recording"><PathIcon Width="22" Height="22" Data="F0 M12,1 A11,11 0 1 0 12,23 A11,11 0 1 0 12,1 Z M8,8 L16,8 16,16 8,16 Z" /></Button>
                <Button Grid.Column="3" Classes="fire-btn square" Command="{Binding SendMessageCommand}" IsVisible="{Binding HasVoiceNote}" IsEnabled="{Binding !IsSendingMessage}" CornerRadius="24" ToolTip.Tip="Send voice note" AutomationProperties.Name="Send voice note"><PathIcon Data="{StaticResource Glyph.Send}" Width="18" Height="18" /></Button>
              </Grid>
            </Border>
            <TextBlock Text="Uploading attachments…" IsVisible="{Binding IsUploadingAttachments}" Classes="caption" />
            <TextBlock Text="{Binding SendError}" TextWrapping="Wrap" Foreground="{DynamicResource ForgeDanger}" FontSize="12" IsVisible="{Binding SendError, Converter={StaticResource NullToBoolConverter}}" />
          </StackPanel>
        </Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="340" IsVisible="{Binding SelectedRecipient, Converter={StaticResource NullToBoolConverter}, ConverterParameter=invert}"><Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource ForgePrimaryGradientSubtle}" HorizontalAlignment="Center"><PathIcon Data="{StaticResource Glyph.Chat}" Width="30" Height="30" Foreground="{DynamicResource ForgePrimary}" /></Border><TextBlock Text="A place for your conversations" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Choose a chat or find a colleague to start talking." Foreground="{DynamicResource ForgeTextMuted}" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
        <Border Grid.Column="1" x:Name="ConversationDrawer" Width="310" views:RevealMotion.Kind="Drawer" views:RevealMotion.IsOpen="{Binding ShowConversationDetails}" Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1,0,0,0" Padding="18">
          <Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16"><StackPanel Spacing="4"><TextBlock Text="Conversation details" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedRecipientName}" Classes="caption" TextTrimming="CharacterEllipsis" /></StackPanel><Button Grid.Column="1" Classes="quiet square" Command="{Binding CloseConversationDetailsCommand}" AutomationProperties.Name="Close conversation details"><PathIcon Data="{StaticResource Glyph.Close}" Width="13" Height="13" /></Button></Grid>
            <TabControl Grid.Row="1" Classes="details-tabs" SelectedIndex="{Binding ConversationDetailsTab}" FontSize="12">
              <TabItem Header="Files"><Grid RowDefinitions="Auto,*,Auto"><Button Content="Refresh files" Classes="quiet" Command="{Binding LoadAttachmentsCommand}" HorizontalAlignment="Left" /><ListBox Grid.Row="1" ItemsSource="{Binding AllAttachments}" Margin="0,12"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChatAttachmentItemViewModel"><Button Classes="quiet" Command="{Binding DownloadCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Spacing="5"><TextBlock Text="{Binding FileName}" MaxWidth="230" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding FormattedFileSize}" Classes="caption" /></StackPanel></Button></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="Load more" Classes="quiet" Command="{Binding MoreAttachmentsCommand}" /></Grid></TabItem>
              <TabItem Header="Members"><StackPanel Spacing="14" Margin="0,16"><TextBlock Text="Add a colleague" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding Workspace.People}" SelectedItem="{Binding SelectedNewMember}" PlaceholderText="Choose a colleague" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PersonSelection"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="Add to conversation" Classes="fire-btn" Command="{Binding AddMemberCommand}" /><TextBlock Text="Adding someone to a direct chat creates a separate group conversation." Classes="caption" TextWrapping="Wrap" /></StackPanel></TabItem>
              <TabItem Header="Security"><ScrollViewer><StackPanel Spacing="12" Margin="0,16"><TextBlock Text="Chat security" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding SecurityStatus}" Classes="caption" TextWrapping="Wrap" /><Button Content="Refresh status" Classes="quiet" Command="{Binding LoadSecurityCommand}" /><TextBox Text="{Binding Workspace.ChatPin}" PasswordChar="●" PlaceholderText="Your six-digit PIN" MaxLength="6" /><Button Content="Unlock this device" Classes="fire-btn" Command="{Binding Workspace.UnlockChatCommand}" />
                <Expander Header="Manage PIN"><StackPanel Spacing="10" Margin="0,12,0,0"><TextBox Text="{Binding SecurityPin}" PasswordChar="●" PlaceholderText="Current or new PIN" MaxLength="6" /><TextBox Text="{Binding SecurityConfirmation}" PasswordChar="●" PlaceholderText="Confirm new PIN" MaxLength="6" /><Button Content="Set PIN" Command="{Binding ChangeSecurityCommand}" CommandParameter="Set" /><TextBox Text="{Binding SecurityPassword}" PasswordChar="●" PlaceholderText="Account password" /><Button Content="Disable PIN" Command="{Binding ChangeSecurityCommand}" CommandParameter="Disable" /></StackPanel></Expander>
                <Expander Header="Recover access"><StackPanel Spacing="10" Margin="0,12,0,0"><Button Content="Email recovery code" Command="{Binding ChangeSecurityCommand}" CommandParameter="Recovery" /><TextBox Text="{Binding SecurityOtp}" PasswordChar="●" PlaceholderText="Emailed code" /><TextBox Text="{Binding SecurityPin}" PasswordChar="●" PlaceholderText="New PIN" MaxLength="6" /><Button Content="Reset PIN" Command="{Binding ChangeSecurityCommand}" CommandParameter="Reset" /></StackPanel></Expander>
              </StackPanel></ScrollViewer></TabItem>
            </TabControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border x:Name="ProfileOverlay" Background="#99000000" views:RevealMotion.Kind="Overlay" views:RevealMotion.IsOpen="{Binding IsProfileOverlayOpen}">
      <Border x:Name="ProfileCard" views:RevealMotion.IsOpen="{Binding IsProfileOverlayOpen}" MaxWidth="720" MaxHeight="760" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource ForgeSurface}" CornerRadius="20" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1" Padding="26">
        <Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,24"><Button Classes="quiet" Padding="0" Command="{Binding OpenImagePreviewCommand}"><Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource ForgePrimaryGradientSubtle}" ClipToBounds="True"><Panel><TextBlock Text="{Binding ProfileInitials}" FontSize="22" Foreground="{DynamicResource ForgePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding ProfileAvatar}" Stretch="UniformToFill" /></Panel></Border></Button><StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="6"><TextBlock Text="{Binding ProfileUserName}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding ProfileEmailText}" Foreground="{DynamicResource ForgeTextSecondary}" /></StackPanel><Button Grid.Column="2" Classes="quiet square" Command="{Binding CloseUserProfileCommand}" VerticalAlignment="Top" AutomationProperties.Name="Close profile"><PathIcon Data="{StaticResource Glyph.Close}" Width="14" Height="14" /></Button></Grid>
          <ScrollViewer Grid.Row="1"><StackPanel Spacing="18"><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingProfile}" Height="2" /><TextBlock Text="ORGANIZATION DIRECTORY" Classes="section-label" /><TextBlock Text="Organization information is unavailable." Foreground="{DynamicResource ForgeTextSecondary}" IsVisible="{Binding !HasProfileOrganization}" TextWrapping="Wrap" /><ContentControl Content="{Binding ProfileOrganization}"><ContentControl.ContentTemplate><DataTemplate x:DataType="vm:ProfileOrganizationViewModel"><views:ProfileOrganizationView /></DataTemplate></ContentControl.ContentTemplate></ContentControl><TextBlock Text="CONTACT" Classes="section-label" /><Grid ColumnDefinitions="*,*" ColumnSpacing="18"><StackPanel Spacing="7"><TextBlock Text="Phone" Classes="caption" /><TextBlock Text="{Binding ProfilePhoneText}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="Address" Classes="caption" /><TextBlock Text="{Binding ProfileAddressText}" TextWrapping="Wrap" /></StackPanel></Grid></StackPanel></ScrollViewer>
          <StackPanel Grid.Row="2" Spacing="10" Margin="0,24,0,0"><TextBox views:EnterSubmit.Command="{Binding SendQuickMessageCommand}" Text="{Binding QuickMessageText}" PlaceholderText="Send a quick message…" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><Button Content="Open conversation" Classes="quiet" Command="{Binding StartChatFromProfileCommand}" /><Button Grid.Column="1" Content="Send message" Classes="fire-btn" Command="{Binding SendQuickMessageCommand}" IsEnabled="{Binding !IsSendingQuickMessage}" /></Grid><TextBlock Text="{Binding QuickMessageStatus}" Classes="caption" /></StackPanel>
        </Grid>
      </Border>
    </Border>
    <Border Background="#E6101114" IsVisible="{Binding IsImagePreviewOpen}" Padding="30"><Grid RowDefinitions="Auto,*"><Button Content="Close preview" Classes="quiet" Command="{Binding CloseImagePreviewCommand}" HorizontalAlignment="Right" /><Image Grid.Row="1" Source="{Binding ProfileAvatar}" Stretch="Uniform" /></Grid></Border>
  </Panel>
</UserControl>
