<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UserIdentityDesktop.ViewModels"
             xmlns:model="using:UserIdentityDesktop.Core.Models"
             xmlns:views="using:UserIdentityDesktop.Views"
             x:Class="UserIdentityDesktop.Views.WorkspaceView" x:DataType="vm:WorkspaceViewModel"
             Background="{DynamicResource ForgeBg}" Foreground="{DynamicResource ForgeTextPrimary}" Classes.reduced-motion="{Binding ReduceMotion}">
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource ForgeSurfaceCard}" />
      <Setter Property="Foreground" Value="{DynamicResource ForgeTextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ForgeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ForgeSurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ForgePrimary}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource ForgeSurfaceCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ForgeBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource ForgeTextPrimary}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource ForgeBgSecondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ForgeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TabItem:selected /template/ ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ForgePrimary}" />
    </Style>
    <Style Selector="UserControl.reduced-motion Button"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector="Border#NavigationRail">
      <Setter Property="Width" Value="70" />
      <Setter Property="Transitions"><Transitions><DoubleTransition Property="Width" Duration="0:0:0.24"><DoubleTransition.Easing><views:AngularNavigationEasing /></DoubleTransition.Easing></DoubleTransition></Transitions></Setter>
    </Style>
    <Style Selector="Border#NavigationRail:pointerover, Border#NavigationRail:focus-within"><Setter Property="Width" Value="210" /></Style>
    <Style Selector="Button.workspace-nav">
      <Setter Property="Width" Value="194" /><Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="14,12" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Foreground" Value="{DynamicResource ForgeTextSecondary}" />
      <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.workspace-nav.active"><Setter Property="Background" Value="{DynamicResource ForgePrimaryGradientSubtle}" /><Setter Property="Foreground" Value="{DynamicResource ForgePrimary}" /></Style>
    <Style Selector="Button.workspace-nav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ForgePrimaryGradientSubtle}" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.workspace-nav TextBlock"><Setter Property="Opacity" Value="0" /><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16" /></Transitions></Setter></Style>
    <Style Selector="Border#NavigationRail:pointerover Button.workspace-nav TextBlock, Border#NavigationRail:focus-within Button.workspace-nav TextBlock"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="TextBlock.sidebar-caption"><Setter Property="Opacity" Value="0" /><Setter Property="Foreground" Value="{DynamicResource ForgeTextSecondary}" /><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Border#NavigationRail:pointerover TextBlock.sidebar-caption, Border#NavigationRail:focus-within TextBlock.sidebar-caption"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="UserControl.reduced-motion Border#NavigationRail"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector="UserControl.reduced-motion Button.workspace-nav TextBlock"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector="TabControl#WorkspaceTabs /template/ ItemsPresenter#PART_ItemsPresenter"><Setter Property="Height" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="13" /></Style>
  </UserControl.Styles>
  <UserControl.KeyBindings><KeyBinding Gesture="Ctrl+Alt+Escape" Command="{Binding StopControlCommand}" /></UserControl.KeyBindings>
  <Grid ColumnDefinitions="70,*">
  <Border x:Name="NavigationRail" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Stretch" ZIndex="20" ClipToBounds="True" Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,*,Auto" Margin="8,22,8,16">
      <StackPanel Height="28" Margin="14,0,14,8" Orientation="Horizontal" Spacing="16"><Border Width="24" Height="2" Background="{DynamicResource ForgeBorder}" /><TextBlock Classes="sidebar-caption" Text="WORKSPACE" VerticalAlignment="Center" /></StackPanel>
      <StackPanel Grid.Row="1" Spacing="8">
        <Button Classes="workspace-nav active" Tag="0" Click="Navigate_Click" AutomationProperties.Name="Chat" ToolTip.Tip="Chat"><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Width="24" Height="24" Data="M2,3 L22,3 22,17 8,17 2,22 Z M5,6 L19,6 19,14 7,14 5,16 Z" /><TextBlock Text="Chat" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Classes="workspace-nav" Tag="1" Click="Navigate_Click" AutomationProperties.Name="Meetings" ToolTip.Tip="Meetings"><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Width="24" Height="24" Data="M2,5 L16,5 16,19 2,19 Z M18,9 L23,6 23,18 18,15 Z" /><TextBlock Text="Meetings" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Classes="workspace-nav" Tag="2" Click="Navigate_Click" AutomationProperties.Name="Calendar" ToolTip.Tip="Calendar"><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Width="24" Height="24" Data="M5,2 L7,2 7,5 17,5 17,2 19,2 19,5 22,5 22,22 2,22 2,5 5,5 Z M4,10 L4,20 20,20 20,10 Z M7,12 L10,12 10,15 7,15 Z M13,12 L16,12 16,15 13,15 Z" /><TextBlock Text="Calendar" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Classes="workspace-nav" Tag="3" Click="Navigate_Click" AutomationProperties.Name="Announcements" ToolTip.Tip="Announcements"><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Width="24" Height="24" Data="M2,8 L9,8 20,3 20,21 9,16 7,16 8,22 4,22 3,16 2,16 Z M22,9 L24,9 24,15 22,15 Z" /><TextBlock Text="Announcements" VerticalAlignment="Center" /></StackPanel></Button>
      </StackPanel>
      <Button Grid.Row="2" Classes="workspace-nav" Tag="4" Click="Navigate_Click" AutomationProperties.Name="Media settings" ToolTip.Tip="Media settings"><StackPanel Orientation="Horizontal" Spacing="16"><PathIcon Width="24" Height="24" Data="M3,5 L21,5 21,7 3,7 Z M3,11 L21,11 21,13 3,13 Z M3,17 L21,17 21,19 3,19 Z M7,2 L9,2 9,10 7,10 Z M15,8 L17,8 17,16 15,16 Z M7,14 L9,14 9,22 7,22 Z" /><TextBlock Text="Media settings" VerticalAlignment="Center" /></StackPanel></Button>
    </Grid>
  </Border>
  <Grid Grid.Column="1">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Padding="16,10" Background="{DynamicResource ForgeSurface}" IsVisible="{Binding Incoming, Converter={StaticResource NullToBoolConverter}}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding IncomingLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
        <Button Grid.Column="1" Content="Accept" Command="{Binding AcceptCommand}" Margin="8,0" />
        <Button Grid.Column="2" Content="Decline" Command="{Binding DeclineCommand}" />
      </Grid>
    </Border>
    <TabControl x:Name="WorkspaceTabs" Grid.Row="2" Margin="0" Padding="0" BorderThickness="0" FontSize="13">
      <TabItem Header="Chat">
        <ContentControl Content="{Binding Chat}" />
      </TabItem>
      <TabItem Header="Meetings">
        <ScrollViewer><StackPanel Margin="28" Spacing="18" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="Meet face to face" FontSize="26" FontWeight="Bold" />
          <TextBlock Text="Join with a meeting code. Schedule a meeting from Calendar and invite your colleagues." TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding MeetingCode}" PlaceholderText="Meeting code" MinWidth="280" />
            <Button Grid.Column="1" Content="Join meeting" Command="{Binding JoinMeetingCommand}" IsEnabled="{Binding !InCall}" Margin="10,0,0,0" /></Grid>
          <TextBlock Text="Microphone and camera start off. Enable each device when you are ready." TextWrapping="Wrap" Foreground="{DynamicResource ForgeTextSecondary}" />
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Calendar">
        <Grid ColumnDefinitions="*,340" Margin="16">
          <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,0,18,0">
            <TextBlock Text="Your schedule" FontSize="24" FontWeight="Bold" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,12">
              <DatePicker SelectedDate="{Binding RangeDate}" />
              <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" />
            </StackPanel>
            <ListBox Grid.Row="2" ItemsSource="{Binding Calendar}" SelectedItem="{Binding SelectedCalendar}">
              <ListBox.ItemTemplate><DataTemplate x:DataType="model:CalendarItem">
                <StackPanel Margin="6" Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding When}" FontSize="12" Foreground="{DynamicResource ForgeTextSecondary}" />
                  <TextBlock Text="{Binding Kind}" FontSize="11" />
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxHeight="60" />
                  <TextBlock Text="{Binding MeetingLink}" TextWrapping="Wrap" FontSize="11" />
                </StackPanel>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="3" Spacing="8" Margin="0,10">
              <TextBlock Text="{Binding DateRange}" FontSize="12" />
              <WrapPanel><Button Content="Review invitation" Command="{Binding ReviewInvitationCommand}" Margin="0,0,8,0" />
                <Button Content="Accept" Command="{Binding AcceptEventCommand}" IsEnabled="{Binding ResponseReviewed}" Margin="0,0,8,0" />
                <Button Content="Decline" Command="{Binding DeclineEventCommand}" Margin="0,0,8,0" />
                <Button Content="Cancel event" Command="{Binding CancelEventCommand}" /></WrapPanel>
              <Button Content="Join selected meeting" Command="{Binding JoinSelectedMeetingCommand}" />
              <ItemsControl ItemsSource="{Binding ResponseConflicts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="model:CalendarConflict">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <CheckBox Content="I acknowledge invitation conflicts" IsChecked="{Binding AcknowledgeResponseConflicts}" IsVisible="{Binding ResponseReviewed}" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Column="1"><StackPanel Spacing="10" IsEnabled="{Binding !IsLoading}">
            <TextBlock Text="Schedule something" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Title" /><TextBox Text="{Binding EventTitle}" MaxLength="200" />
            <TextBlock Text="Description" /><TextBox Text="{Binding EventDescription}" AcceptsReturn="True" Height="70" />
            <TextBlock Text="Date and local time" /><DatePicker SelectedDate="{Binding EventDate}" /><TimePicker SelectedTime="{Binding EventTime}" />
            <TextBlock Text="Duration in minutes" /><TextBox Text="{Binding DurationMinutes}" />
            <TextBlock Text="Invite people" />
            <ListBox ItemsSource="{Binding People}" Height="130"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:PersonSelection">
              <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" />
            </DataTemplate></ListBox.ItemTemplate></ListBox>
            <CheckBox Content="Online meeting" IsChecked="{Binding IsMeeting}" />
            <Button Content="Review availability" Command="{Binding ReviewEventCommand}" />
            <ItemsControl ItemsSource="{Binding Conflicts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="model:CalendarConflict">
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <CheckBox Content="I acknowledge the reviewed conflicts" IsChecked="{Binding AcknowledgeConflicts}" />
            <Button Content="Save schedule" Command="{Binding SaveEventCommand}" IsEnabled="{Binding Reviewed}" />
          </StackPanel></ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Announcements">
        <Grid ColumnDefinitions="*,320" RowDefinitions="Auto,*,Auto" Margin="24">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16"><TextBlock Text="Announcements" FontSize="26" FontWeight="Bold" />
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" /></Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Announcements}" SelectedItem="{Binding SelectedAnnouncement}">
            <ListBox.ItemTemplate><DataTemplate x:DataType="model:Announcement">
              <Border Padding="14" Margin="0,4" Background="{DynamicResource ForgeSurfaceCard}" CornerRadius="10">
                <StackPanel Spacing="8"><TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource ForgePrimary}" />
                  <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                  <TextBlock Text="Important" IsVisible="{Binding Important}" FontWeight="Bold" />
                  <TextBlock Text="Acknowledgement requested" IsVisible="{Binding RequiresAcknowledgement}" FontSize="12" />
                  <TextBlock Text="Acknowledged" IsVisible="{Binding Acknowledged}" FontSize="12" />
                </StackPanel>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="2" Content="Acknowledge selected announcement" Command="{Binding AcknowledgeCommand}" Margin="0,12,0,0" />
          <ScrollViewer Grid.Column="1" Grid.RowSpan="3" Margin="20,0,0,0"><StackPanel Spacing="10" IsEnabled="{Binding !IsLoading}">
            <TextBlock Text="Publish an announcement" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Title" /><TextBox Text="{Binding AnnouncementTitle}" MaxLength="200" />
            <TextBlock Text="Message" /><TextBox Text="{Binding AnnouncementBody}" AcceptsReturn="True" Height="130" />
            <TextBlock Text="Audience" />
            <ListBox ItemsSource="{Binding Audience}" Height="170"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:PersonSelection">
              <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" />
            </DataTemplate></ListBox.ItemTemplate></ListBox>
            <CheckBox Content="Important" IsChecked="{Binding AnnouncementImportant}" />
            <CheckBox Content="Request acknowledgement" IsChecked="{Binding RequiresAcknowledgement}" />
            <TextBlock Text="Published immediately for 7 days. Your publishing permissions apply." TextWrapping="Wrap" FontSize="12" />
            <Button Content="Publish" Command="{Binding PublishCommand}" />
          </StackPanel></ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Media settings">
        <ScrollViewer><StackPanel Margin="28" Spacing="12" MaxWidth="620" HorizontalAlignment="Left">
          <TextBlock Text="Native media devices" FontSize="26" FontWeight="Bold" />
          <CheckBox Content="Reduce motion" IsChecked="{Binding ReduceMotion}" />
          <TextBlock Text="{Binding DeviceHelp}" TextWrapping="Wrap" />
          <Button Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" IsEnabled="{Binding !CheckingDevices}" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding CheckingDevices}" Height="3" />
          <TextBlock Text="{Binding DeviceStatus}" TextWrapping="Wrap" Foreground="{DynamicResource ForgeTextSecondary}" />
          <TextBlock Text="Camera: up to 1080p at 30 FPS. Screen sharing: up to 1080p at 60 FPS. Delivered quality adapts to your connection and device." TextWrapping="Wrap" Foreground="{DynamicResource ForgeTextSecondary}" />
          <TextBlock Text="Microphone" />
          <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" HorizontalAlignment="Stretch" MinWidth="300"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:MediaDeviceOption"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <Button Content="Check microphone" Command="{Binding CheckMicrophoneCommand}" IsEnabled="{Binding !CheckingDevices}" /><ProgressBar Value="{Binding MicrophonePeak}" Maximum="100" Height="5" />
          <TextBlock Text="Speaker / headphones" />
          <ComboBox ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:MediaDeviceOption"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <Button Content="Check speaker" Command="{Binding CheckSpeakerCommand}" IsEnabled="{Binding !CheckingDevices}" />
          <TextBlock Text="Camera" />
          <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" PlaceholderText="No camera selected" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:MediaDeviceOption"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <Button Content="Check camera" Command="{Binding CheckCameraCommand}" IsEnabled="{Binding !CheckingDevices}" />
          <views:NativeVideoView Frame="{Binding CameraPreview}" Height="180" IsVisible="{Binding CameraPreview, Converter={StaticResource NullToBoolConverter}}" />
          <TextBlock Text="Screen device / X11 display" /><TextBox Text="{Binding ScreenDevice}" />
          <TextBlock Text="Use headphones to prevent echo. This capture provider does not yet apply acoustic echo cancellation. Device changes apply the next time you enable that device." TextWrapping="Wrap" Foreground="{DynamicResource ForgeTextSecondary}" />
          <TextBlock Text="Chat security" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />
          <TextBlock Text="If your account has a chat PIN, unlock encrypted messages for this session." TextWrapping="Wrap" />
          <TextBox Text="{Binding ChatPin}" PasswordChar="●" MaxLength="6" PlaceholderText="Chat PIN" />
          <Button Content="Unlock chat" Command="{Binding UnlockChatCommand}" />
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="3" Margin="16,4" Spacing="4">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" />
      <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" MaxHeight="80" Foreground="{DynamicResource ForgeTextSecondary}" />
    </StackPanel>
  </Grid>
  </Grid>
  </Grid>
</UserControl>
