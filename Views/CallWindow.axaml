<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UserIdentityDesktop.ViewModels"
        xmlns:model="using:UserIdentityDesktop.Core.Models"
        xmlns:views="using:UserIdentityDesktop.Views"
        x:Class="UserIdentityDesktop.Views.CallWindow" x:DataType="vm:WorkspaceViewModel"
        Title="{Binding CallTitle}" Width="1240" Height="800" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ForgeBg}" Foreground="{DynamicResource ForgeTextPrimary}">
  <Window.KeyBindings><KeyBinding Gesture="Ctrl+Alt+Escape" Command="{Binding StopControlCommand}" /></Window.KeyBindings>
  <Window.Styles>
    <Style Selector="Button.call-control"><Setter Property="Padding" Value="12,9" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Background" Value="{DynamicResource ForgeSurfaceCard}" /><Setter Property="BorderBrush" Value="{DynamicResource ForgeBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource ForgeTextPrimary}" /></Style>
    <Style Selector="Button.call-control.active"><Setter Property="Foreground" Value="{DynamicResource ForgePrimary}" /><Setter Property="BorderBrush" Value="{DynamicResource ForgePrimary}" /></Style>
    <Style Selector="Button.media-control"><Setter Property="MinWidth" Value="70" /><Setter Property="Height" Value="60" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="12,7" /></Style>
    <Style Selector="Button.media-control.off"><Setter Property="Background" Value="{DynamicResource ForgeDanger}" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="Button.media-control.off:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ForgeDanger}" /><Setter Property="Opacity" Value="0.85" /></Style>
    <Style Selector="Button.media-control.active"><Setter Property="Background" Value="{DynamicResource ForgePrimary}" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Border.participant-card"><Setter Property="CornerRadius" Value="16" /><Setter Property="BorderBrush" Value="{DynamicResource ForgeBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="{DynamicResource ForgeBgSecondary}" /><Setter Property="Height" Value="280" /><Setter Property="Margin" Value="6" /><Setter Property="ClipToBounds" Value="True" /></Style>
    <Style Selector="Border.participant-card:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource ForgeBorderFocus}" /></Style>
    <Style Selector="Grid#CallBody"><Setter Property="Margin" Value="20,16" /></Style>
    <Style Selector="Window.share-fullscreen Grid#CallBody"><Setter Property="Margin" Value="0" /></Style>
    <Style Selector="Window.share-fullscreen Border#CallHeader, Window.share-fullscreen Border#CallFooter, Window.share-fullscreen StackPanel#CallSupplement"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Button#ExitFullscreenButton"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Window.share-fullscreen Button#ExitFullscreenButton"><Setter Property="IsVisible" Value="True" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border x:Name="CallHeader" Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource ForgePrimaryGradient}" VerticalAlignment="Center"><PathIcon Data="{StaticResource Glyph.Phone}" Width="18" Height="18" Foreground="White" /></Border>
        <StackPanel Grid.Column="1" Spacing="5" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="{Binding CallTitle}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ParticipantSummary}" Foreground="{DynamicResource ForgeTextMuted}" FontSize="12" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="quiet" Content="Chat" Command="{Binding ToggleCallChatCommand}" />
          <Button Classes="quiet" Content="Members" Command="{Binding ToggleCallMembersCommand}" />
          <Button x:Name="FullscreenButton" Classes="quiet" Content="Full screen" Click="Fullscreen_Click" IsVisible="{Binding HasFocusedScreen}" AutomationProperties.Name="Full screen screen share" ToolTip.Tip="Full screen (F11); Escape to return" />
          <Button Classes="quiet" Content="Gallery" Command="{Binding ClearVideoFocusCommand}" IsVisible="{Binding HasFocusedVideo}" />
          <Button Content="Devices" Classes="quiet" Margin="0" Click="Devices_Click" AutomationProperties.Name="Call devices">
            <Button.Flyout><Flyout><StackPanel Width="320" Spacing="10">
              <TextBlock Text="Call devices" FontSize="18" FontWeight="SemiBold" />
              <Button Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" IsEnabled="{Binding !CheckingDevices}" />
              <TextBlock Text="Microphone" />
              <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:MediaDeviceOption"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Text="Speaker / headphones" />
              <ComboBox ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:MediaDeviceOption"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Text="Camera" />
              <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:MediaDeviceOption"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Text="{Binding DeviceStatus}" TextWrapping="Wrap" FontSize="12" />
              <TextBlock Text="Microphone and camera changes apply when you next enable them. Speaker changes apply immediately." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ForgeTextSecondary}" />
            </StackPanel></Flyout></Button.Flyout>
          </Button></StackPanel>
      </Grid>
</Border><Grid x:Name="CallBody" Grid.Row="1" RowDefinitions="*,Auto,Auto">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <Grid>
          <ScrollViewer IsVisible="{Binding !HasFocusedVideo}">
            <ItemsControl ItemsSource="{Binding Videos}" VerticalAlignment="Top">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding GalleryColumns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:VideoTileViewModel">
                <Border Classes="participant-card" PointerPressed="Tile_Pressed" ContextRequested="Tile_ContextRequested" AutomationProperties.Name="{Binding Name}">
                  <Grid>
                    <views:NativeVideoView Frame="{Binding Frame}" IsVisible="{Binding HasFrame}" RemoteControlEnabled="{Binding CanControl}" InputCommand="{Binding InputCommand}" />
                    <Border Width="86" Height="86" CornerRadius="43" BorderBrush="#CCFFFFFF" BorderThickness="2" Background="{DynamicResource ForgePrimaryGradient}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasFrame}"><TextBlock Text="{Binding Initials}" FontSize="29" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Grid ColumnDefinitions="*,Auto" Margin="16,14" VerticalAlignment="Top"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><Border Grid.Column="1" Background="{DynamicResource ForgeSurface}" CornerRadius="6" Padding="7,4"><TextBlock Text="{Binding Quality}" Classes="caption" /></Border></Grid>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Background="{DynamicResource ForgeSurface}" CornerRadius="7" Padding="9,6"><TextBlock Text="{Binding MicrophoneLabel}" FontSize="11" Foreground="{DynamicResource ForgeTextSecondary}" /></Border>
                    <Button Classes="quiet square" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10" Click="TileMenu_Click" AutomationProperties.Name="Participant actions"><PathIcon Data="{StaticResource Glyph.More}" Width="16" Height="16" /></Button>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <ContentControl Content="{Binding FocusedVideo}" ContextRequested="FocusedTile_ContextRequested" IsVisible="{Binding FocusedVideo, Converter={StaticResource NullToBoolConverter}}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ContentControl.ContentTemplate><DataTemplate x:DataType="vm:VideoTileViewModel">
              <Grid RowDefinitions="*,Auto"><views:NativeVideoView Frame="{Binding Frame}" RemoteControlEnabled="{Binding CanControl}" InputCommand="{Binding InputCommand}" />
                <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="12" FontSize="12" Foreground="{DynamicResource ForgeTextSecondary}" /></Grid>
            </DataTemplate></ContentControl.ContentTemplate>
          </ContentControl>
        </Grid>
        <Border Grid.Column="1" Width="248" Margin="18,0,0,0" Padding="18" Background="{DynamicResource ForgeSurfaceCard}" CornerRadius="12" IsVisible="{Binding ShowCallMembers}">
          <StackPanel Spacing="16"><TextBlock Text="In this call" FontSize="17" FontWeight="SemiBold" /><ScrollViewer MaxHeight="320"><ItemsControl ItemsSource="{Binding Videos}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:VideoTileViewModel"><Border Padding="10,12" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,0,0,1" IsVisible="{Binding !IsScreen}"><StackPanel Spacing="5"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" /><TextBlock Text="{Binding MicrophoneLabel}" Classes="caption" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedCallInvitee}" PlaceholderText="Invite colleague" IsVisible="{Binding CanInviteToCall}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PersonSelection"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <Button Content="Invite to call" Command="{Binding InviteCallCommand}" IsVisible="{Binding CanInviteToCall}" /></StackPanel></Border>
        <Border Grid.Column="2" Width="300" IsVisible="{Binding ShowCallChat}" Margin="18,0,0,0" Padding="18" CornerRadius="12" Background="{DynamicResource ForgeSurfaceCard}">
          <Grid RowDefinitions="Auto,*,Auto,Auto"><TextBlock Text="{Binding Chat.SelectedRecipientName, StringFormat='Chat: {0}'}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Chat.Messages}" Margin="0,10"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:ChatMessageItemViewModel"><Border Background="{DynamicResource ForgeBgSecondary}" CornerRadius="10" Padding="12" Margin="0,5" ContextRequested="CallMessage_ContextRequested"><StackPanel Spacing="5"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" /><TextBlock Text="{Binding CallLabel}" IsVisible="{Binding IsCall}" /><TextBlock Text="{Binding TimeSent, Converter={StaticResource DateTimeFormatConverter}}" Classes="caption" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <TextBox Grid.Row="2" Text="{Binding Chat.MessageDraft}" PlaceholderText="Message current conversation" AcceptsReturn="True" MaxHeight="90" />
            <Button Grid.Row="3" Content="Send" Command="{Binding Chat.SendMessageCommand}" Margin="0,8,0,0" />
          </Grid>
        </Border>
      </Grid>
      <StackPanel x:Name="CallSupplement" Grid.Row="1" MaxHeight="180">
        <Expander Header="Remote desktop" IsExpanded="False" IsVisible="{Binding RemoteDesktopAvailable}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding RemoteControlLabel}" TextWrapping="Wrap" />
            <WrapPanel>
              <ComboBox ItemsSource="{Binding RemotePeers}" SelectedItem="{Binding SelectedRemotePeer}" MinWidth="220" MaxWidth="380" PlaceholderText="Native participant">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="model:NativePeer"><TextBlock Text="{Binding Identity}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Request control" Command="{Binding RequestControlCommand}" IsEnabled="{Binding CanRequestControl}" Margin="8,0" />
              <Button Content="Stop control / revoke access" Command="{Binding StopControlCommand}" IsEnabled="{Binding HasRemoteControl}" />
            </WrapPanel>
            <Border Background="{DynamicResource ForgeBgSecondary}" BorderBrush="{DynamicResource ForgePrimary}" BorderThickness="1" Padding="12" CornerRadius="8" IsVisible="{Binding ControlRequester, Converter={StaticResource NullToBoolConverter}}">
              <StackPanel Spacing="8">
                <TextBlock Text="A participant requests keyboard and mouse control of your shared desktop:" TextWrapping="Wrap" FontWeight="Bold" />
                <TextBlock Text="{Binding ControlRequester}" />
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Allow for 5 minutes" Command="{Binding AllowControlCommand}" />
                  <Button Content="Deny" Command="{Binding DenyControlCommand}" /></StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>
        <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Foreground="{DynamicResource ForgeTextSecondary}" Margin="0,12" />
</StackPanel></Grid>    <Button x:Name="ExitFullscreenButton" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" ZIndex="50" Classes="call-control" Content="Exit full screen (Esc)" Click="Fullscreen_Click" AutomationProperties.Name="Exit full screen screen share" />
    <Border x:Name="CallFooter" Grid.Row="2" Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,1,0,0" Padding="20,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
        <Button Classes="media-control" Classes.off="{Binding !MicrophoneEnabled}" Command="{Binding ToggleMicrophoneCommand}" AutomationProperties.Name="Toggle microphone"><StackPanel Spacing="5" HorizontalAlignment="Center"><PathIcon Width="18" Height="20" Data="M9,2 L15,2 15,14 9,14 Z M5,10 L7,10 7,15 17,15 17,10 19,10 19,17 13,17 13,21 17,21 17,23 7,23 7,21 11,21 11,17 5,17 Z" /><TextBlock Text="{Binding MicrophoneActionLabel}" FontSize="11" HorizontalAlignment="Center" /></StackPanel></Button>
        <Button Classes="media-control" Classes.off="{Binding !CameraEnabled}" Command="{Binding ToggleCameraCommand}" AutomationProperties.Name="Toggle camera"><StackPanel Spacing="5" HorizontalAlignment="Center"><PathIcon Width="21" Height="20" Data="M2,5 L16,5 16,19 2,19 Z M18,9 L23,6 23,18 18,15 Z" /><TextBlock Text="{Binding CameraActionLabel}" FontSize="11" HorizontalAlignment="Center" /></StackPanel></Button>
        <Button Classes="media-control" Classes.active="{Binding ScreenEnabled}" Command="{Binding ToggleScreenCommand}" AutomationProperties.Name="Toggle screen sharing"><StackPanel Spacing="5" HorizontalAlignment="Center"><PathIcon Width="21" Height="20" Data="M1,3 L23,3 23,19 14,19 14,22 19,22 19,24 5,24 5,22 10,22 10,19 1,19 Z M3,5 L3,17 21,17 21,5 Z M11,15 L11,10 8,10 12,6 16,10 13,10 13,15 Z" /><TextBlock Text="{Binding ScreenActionLabel}" FontSize="11" HorizontalAlignment="Center" /></StackPanel></Button>
        <Button Classes="media-control danger" Command="{Binding LeaveCommand}" AutomationProperties.Name="Leave call"><StackPanel Spacing="5"><PathIcon Data="{StaticResource Glyph.Phone}" Width="20" Height="20" HorizontalAlignment="Center" /><TextBlock Text="Leave call" FontSize="11" HorizontalAlignment="Center" /></StackPanel></Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
