<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UserIdentityDesktop.ViewModels"
        xmlns:model="using:UserIdentityDesktop.Core.Models"
        xmlns:views="using:UserIdentityDesktop.Views"
        x:Class="UserIdentityDesktop.Views.CallWindow" x:DataType="vm:WorkspaceViewModel"
        Title="{Binding CallTitle}" Width="1080" Height="780" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ForgeBg}" Foreground="{DynamicResource ForgeTextPrimary}">
  <Window.KeyBindings><KeyBinding Gesture="Ctrl+Alt+Escape" Command="{Binding StopControlCommand}" /></Window.KeyBindings>
  <Window.Styles>
    <Style Selector="Button.call-control"><Setter Property="Padding" Value="18,12" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Background" Value="{DynamicResource ForgeSurfaceCard}" /><Setter Property="BorderBrush" Value="{DynamicResource ForgeBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource ForgeTextPrimary}" /></Style>
    <Style Selector="Button.call-control.active"><Setter Property="Foreground" Value="{DynamicResource ForgePrimary}" /><Setter Property="BorderBrush" Value="{DynamicResource ForgePrimary}" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,0,0,1" Padding="16,0"><Grid ColumnDefinitions="*,Auto" Margin="8,12,8,16"><StackPanel Spacing="6"><TextBlock Text="{Binding CallTitle}" FontSize="24" FontWeight="Bold" />
          <TextBlock Text="Connected" Foreground="{DynamicResource ForgeTextSecondary}" FontSize="12" /></StackPanel>
          <Button Grid.Column="1" Content="Devices" Classes="secondary-btn" Margin="0,0,10,0" Click="Devices_Click" AutomationProperties.Name="Call devices">
            <Button.Flyout><Flyout><StackPanel Width="320" Spacing="10">
              <TextBlock Text="Call devices" FontSize="18" FontWeight="SemiBold" />
              <Button Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" IsEnabled="{Binding !CheckingDevices}" />
              <TextBlock Text="Microphone" />
              <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:MediaDeviceOption"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Text="Speaker / headphones" />
              <ComboBox ItemsSource="{Binding Speakers}" SelectedItem="{Binding SelectedSpeaker}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:MediaDeviceOption"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Text="Camera" />
              <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:MediaDeviceOption"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Text="{Binding DeviceStatus}" TextWrapping="Wrap" FontSize="12" />
              <TextBlock Text="Microphone and camera changes apply when you next enable them. Speaker changes apply immediately." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ForgeTextSecondary}" />
            </StackPanel></Flyout></Button.Flyout>
          </Button></Grid>
</Border><ScrollViewer Grid.Row="1"><StackPanel Margin="24" Spacing="12">
        <Border MinHeight="400" Margin="0,16" Background="{DynamicResource ForgeBg}" CornerRadius="16" IsVisible="{Binding !Videos.Count}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
          <Border Width="96" Height="96" CornerRadius="48" Background="{DynamicResource ForgePrimaryGradient}" HorizontalAlignment="Center"><TextBlock Text="{Binding Chat.CurrentUser.Initials}" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock Text="{Binding CallTitle}" FontSize="24" HorizontalAlignment="Center" />
          <TextBlock Text="Enable your camera or share your screen when you’re ready." TextWrapping="Wrap" Foreground="{DynamicResource ForgeTextSecondary}" />
        </StackPanel></Border>
        <ScrollViewer MaxHeight="500" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Videos}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:VideoTileViewModel">
              <Border Background="#121722" CornerRadius="10" Padding="6" Width="470" Margin="4">
                <StackPanel><views:NativeVideoView Frame="{Binding Frame}" RemoteControlEnabled="{Binding CanControl}" InputCommand="{Binding InputCommand}" Height="260" />
                  <TextBlock Text="{Binding Identity}" Foreground="White" TextTrimming="CharacterEllipsis" FontSize="11" Margin="4" /></StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Expander Header="Remote desktop" IsExpanded="False" IsVisible="{Binding RemoteDesktopAvailable}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding RemoteControlLabel}" TextWrapping="Wrap" />
            <WrapPanel>
              <ComboBox ItemsSource="{Binding RemotePeers}" SelectedItem="{Binding SelectedRemotePeer}" MinWidth="220" MaxWidth="380" PlaceholderText="Native participant">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="model:NativePeer"><TextBlock Text="{Binding Identity}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Request control" Command="{Binding RequestControlCommand}" IsEnabled="{Binding CanRequestControl}" Margin="8,0" />
              <Button Content="Stop control / revoke access" Command="{Binding StopControlCommand}" IsEnabled="{Binding HasRemoteControl}" />
            </WrapPanel>
            <Border Background="{DynamicResource ForgeBgSecondary}" BorderBrush="{DynamicResource ForgePrimary}" BorderThickness="1" Padding="12" CornerRadius="8" IsVisible="{Binding ControlRequester, Converter={StaticResource NullToBoolConverter}}">
              <StackPanel Spacing="8">
                <TextBlock Text="A participant requests keyboard and mouse control of your shared desktop:" TextWrapping="Wrap" FontWeight="Bold" />
                <TextBlock Text="{Binding ControlRequester}" />
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Allow for 5 minutes" Command="{Binding AllowControlCommand}" />
                  <Button Content="Deny" Command="{Binding DenyControlCommand}" /></StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>
        <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" Foreground="{DynamicResource ForgeTextSecondary}" Margin="0,12" />
</StackPanel></ScrollViewer>    <Border Grid.Row="2" Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,1,0,0" Padding="20,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
        <Button Classes="call-control" Classes.active="{Binding MicrophoneEnabled}" Command="{Binding ToggleMicrophoneCommand}" AutomationProperties.Name="Toggle microphone"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="18" Height="20" Data="M9,2 L15,2 15,14 9,14 Z M5,10 L7,10 7,15 17,15 17,10 19,10 19,17 13,17 13,21 17,21 17,23 7,23 7,21 11,21 11,17 5,17 Z" /><TextBlock Text="Microphone" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Classes="call-control" Classes.active="{Binding CameraEnabled}" Command="{Binding ToggleCameraCommand}" AutomationProperties.Name="Toggle camera"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="21" Height="20" Data="M2,5 L16,5 16,19 2,19 Z M18,9 L23,6 23,18 18,15 Z" /><TextBlock Text="Camera" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Classes="call-control" Classes.active="{Binding ScreenEnabled}" Command="{Binding ToggleScreenCommand}" AutomationProperties.Name="Toggle screen sharing"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="21" Height="20" Data="M1,3 L23,3 23,19 14,19 14,22 19,22 19,24 5,24 5,22 10,22 10,19 1,19 Z M3,5 L3,17 21,17 21,5 Z M11,15 L11,10 8,10 12,6 16,10 13,10 13,15 Z" /><TextBlock Text="Share screen" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Classes="call-control" Background="{DynamicResource ForgeDanger}" Foreground="White" Command="{Binding LeaveCommand}" Content="Leave call" AutomationProperties.Name="Leave call" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
