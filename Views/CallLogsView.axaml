<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:UserIdentityDesktop.ViewModels" xmlns:model="using:UserIdentityDesktop.Core.Models" x:Class="UserIdentityDesktop.Views.CallLogsView" x:DataType="vm:WorkspaceViewModel" x:Name="CallLogsRoot">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28" RowSpacing="16">
    <StackPanel Spacing="6"><TextBlock Text="Call Logs" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Recent audio and video calls. Select a call to call again." Foreground="{DynamicResource ForgeTextSecondary}"/></StackPanel>
    <StackPanel Grid.Row="1" Spacing="8"><ProgressBar IsIndeterminate="True" IsVisible="{Binding LoadingCallLogs}" Height="3"/><TextBlock Text="{Binding CallLogsError}" Foreground="{DynamicResource ForgePrimary}" TextWrapping="Wrap"/><Button Content="Refresh call history" Command="{Binding RetryCallLogsCommand}" HorizontalAlignment="Left"/></StackPanel>
    <Grid Grid.Row="2"><TextBlock Text="No calls yet." IsVisible="{Binding !CallLogs.Count}" HorizontalAlignment="Center" VerticalAlignment="Center"/><ListBox ItemsSource="{Binding CallLogs}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="model:CallLogItem"><Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="18" Margin="0,3" Command="{Binding #CallLogsRoot.((vm:WorkspaceViewModel)DataContext).RedialCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="20"><StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource ForgeTextSecondary}"/><TextBlock Text="{Binding When}" FontSize="12" Foreground="{DynamicResource ForgeTextMuted}"/></StackPanel><PathIcon Grid.Column="1" Data="M6,2 L10,6 8,9 C10,13 12,15 16,16 L19,14 23,18 C22,25 13,23 7,17 1,11 0,4 6,2 Z" Width="22" Height="22" Foreground="{DynamicResource ForgePrimary}"/></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
    <Button Grid.Row="3" Content="Load older calls" Command="{Binding OlderCallsCommand}" IsVisible="{Binding HasOlderCalls}" HorizontalAlignment="Center"/>
  </Grid>
</UserControl>
