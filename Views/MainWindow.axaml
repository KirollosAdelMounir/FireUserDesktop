<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:UserIdentityDesktop.ViewModels"
        x:Class="UserIdentityDesktop.Views.MainWindow" x:DataType="vm:MainViewModel" Icon="/Assets/favicon.ico" Title="Fire User Connect"
        MinWidth="800" MinHeight="550" Width="1280" Height="820" FontSize="13" WindowStartupLocation="CenterScreen" Background="{DynamicResource ForgeBg}">
  <Grid RowDefinitions="Auto,*">
    <Border Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="0,0,0,1" Padding="20,10">
      <Grid ColumnDefinitions="Auto,*,Auto"><Image Source="/Assets/PageLogo.png" Width="28" Height="28" Stretch="Uniform" /><TextBlock Grid.Column="1" Text="Fire User Connect" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ForgeTextPrimary}" VerticalAlignment="Center" Margin="10,0" />
        <Button Grid.Column="2" Classes="quiet square" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Switch appearance" AutomationProperties.Name="Switch light or dark theme"><PathIcon Width="17" Height="17" Data="M12,2 A10,10 0 1 0 22,12 C15,17 7,9 12,2 Z" /></Button>
      </Grid>
    </Border>
    <ContentControl Grid.Row="1" Content="{Binding CurrentView}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
</Window>
