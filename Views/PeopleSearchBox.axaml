<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:UserIdentityDesktop.ViewModels" x:Class="UserIdentityDesktop.Views.PeopleSearchBox" x:Name="PeopleSearch" x:DataType="vm:ChatViewModel">
  <Grid><Border CornerRadius="12" Background="{DynamicResource ForgeBgSecondary}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1"><Grid ColumnDefinitions="Auto,*" Margin="12,0,4,0" ColumnSpacing="8"><PathIcon Data="{StaticResource Glyph.Search}" Width="17" Height="17" Foreground="{DynamicResource ForgeTextMuted}"/><TextBox x:Name="SearchInput" Grid.Column="1" Text="{Binding IdentitySearchText}" PlaceholderText="Search people and open a chat…" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Search people and open a chat"/></Grid></Border>
    <Popup x:Name="ResultsPopup" PlacementTarget="{Binding #SearchInput}" Placement="BottomEdgeAlignedLeft" IsOpen="{Binding ShowSearchDropdown,Mode=TwoWay}" IsLightDismissEnabled="True">
      <Border Width="430" MaxHeight="380" Padding="12" CornerRadius="14" Background="{DynamicResource ForgeSurface}" BorderBrush="{DynamicResource ForgeBorder}" BorderThickness="1" BoxShadow="0 6 20 0 #40000000"><StackPanel Spacing="10"><TextBlock Text="People" FontWeight="SemiBold" Foreground="{DynamicResource ForgeTextPrimary}"/><ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding IsSearching}"/><TextBlock Text="No matching people" IsVisible="{Binding NoPeopleSearchResults}" Foreground="{DynamicResource ForgeTextMuted}"/>
        <ScrollViewer MaxHeight="300"><ItemsControl ItemsSource="{Binding SearchResults}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:UserSearchItemViewModel"><Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="9" Margin="0,3" Command="{Binding #PeopleSearch.((vm:ChatViewModel)DataContext).StartChatFromSearchCommand}" CommandParameter="{Binding}"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"><Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True" Background="{DynamicResource ForgePrimaryGradientSubtle}"><Panel><TextBlock Text="{Binding Initials}" Foreground="{DynamicResource ForgePrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Avatar}" Stretch="UniformToFill"/></Panel></Border><TextBlock Grid.Column="1" Text="{Binding FullName}" VerticalAlignment="Center" Foreground="{DynamicResource ForgeTextPrimary}" TextTrimming="CharacterEllipsis"/><PathIcon Grid.Column="2" Data="{StaticResource Glyph.Chat}" Width="18" Height="18" Foreground="{DynamicResource ForgePrimary}"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </StackPanel></Border>
    </Popup>
  </Grid>
</UserControl>
