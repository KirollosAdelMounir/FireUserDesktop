<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:UserIdentityDesktop.ViewModels" xmlns:model="using:UserIdentityDesktop.Core.Models"
        x:Class="UserIdentityDesktop.Views.ScreenSharePicker" x:DataType="vm:ScreenSharePickerViewModel"
        Title="Choose what to share" Width="620" Height="480" MinWidth="420" MinHeight="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ForgeSurface}" Foreground="{DynamicResource ForgeTextPrimary}">
  <Window.Styles>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="14,10" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Margin" Value="0,4" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ForgePrimaryGradientSubtle}" /></Style>
  </Window.Styles>
  <Window.Resources><DataTemplate x:Key="Source" x:DataType="model:ScreenShareSource"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="12,10" /></DataTemplate></Window.Resources>
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <TextBlock Text="Choose what to share" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Text="{Binding Hint}" Foreground="{DynamicResource ForgeTextSecondary}" TextWrapping="Wrap" />
    <TabControl x:Name="SourceTabs" Grid.Row="2" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Entire screen"><ListBox x:Name="ScreenSources" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}" ItemTemplate="{StaticResource Source}" Background="Transparent" /></TabItem>
      <TabItem Header="Window"><Grid><TextBlock Text="No shareable windows are available." HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Windows.Count}" TextWrapping="Wrap" Foreground="{DynamicResource ForgeTextSecondary}" /><ListBox x:Name="WindowSources" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" ItemTemplate="{StaticResource Source}" Background="Transparent" /></Grid></TabItem>
    </TabControl>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="Cancel" Click="Cancel_Click" /><Button x:Name="ShareButton" Content="Share" Classes="fire-btn" IsEnabled="{Binding CanShare}" Click="Share_Click" /></StackPanel>
  </Grid>
</Window>
